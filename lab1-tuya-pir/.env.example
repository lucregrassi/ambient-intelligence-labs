# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore: never commit your credentials.

# --- From the Overview page of your cloud project on platform.tuya.com ---
ACCESS_ID=your_access_id
ACCESS_SECRET=your_access_secret

# --- Must match the data centre of your cloud project ---
# Central Europe   https://openapi.tuyaeu.com
# Western Europe   https://openapi-weaz.tuyaeu.com
# Western America  https://openapi.tuyaus.com
ENDPOINT=https://openapi.tuyaeu.com

# --- From Devices in your cloud project, once the sensor appears there ---
DEVICE_ID=your_device_id

# --- The account of the MOBILE APP, not of the developer platform ---
TUYA_USERNAME=your_app_email
TUYA_PASSWORD=your_app_password

# Country code without the plus sign. Italy is 39.
COUNTRY_CODE=39
