<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.unige.it/ami/classroom.owl"
         xmlns="http://www.unige.it/ami/classroom.owl#">

<owl:Ontology rdf:about="http://www.unige.it/ami/classroom.owl"/>

<owl:ObjectProperty rdf:about="#hosts">
  <rdfs:domain rdf:resource="#Room"/>
  <rdfs:range rdf:resource="#Person"/>
  <owl:inverseOf rdf:resource="#isIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isIn">
  <owl:inverseOf rdf:resource="#hosts"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#equippedWith">
  <rdfs:domain rdf:resource="#Room"/>
  <owl:inverseOf rdf:resource="#placedIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#placedIn">
  <owl:inverseOf rdf:resource="#equippedWith"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#seatedAt">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Desk"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usedFor">
  <rdfs:domain rdf:resource="#Room"/>
  <rdfs:range rdf:resource="#Activity"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#canSee">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Whiteboard"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasHeadCount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Room"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Room">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Furniture">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Device">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Activity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Classroom">
  <rdfs:subClassOf rdf:resource="#Room"/>
</owl:Class>

<owl:Class rdf:about="#Office">
  <rdfs:subClassOf rdf:resource="#Room"/>
</owl:Class>

<owl:Class rdf:about="#Corridor">
  <rdfs:subClassOf rdf:resource="#Room"/>
</owl:Class>

<owl:Class rdf:about="#Desk">
  <rdfs:subClassOf rdf:resource="#Furniture"/>
</owl:Class>

<owl:Class rdf:about="#Chair">
  <rdfs:subClassOf rdf:resource="#Furniture"/>
</owl:Class>

<owl:Class rdf:about="#Whiteboard">
  <rdfs:subClassOf rdf:resource="#Furniture"/>
</owl:Class>

<owl:Class rdf:about="#Projector">
  <rdfs:subClassOf rdf:resource="#Device"/>
</owl:Class>

<owl:Class rdf:about="#PresenceSensor">
  <rdfs:subClassOf rdf:resource="#Device"/>
</owl:Class>

<owl:Class rdf:about="#Student">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:disjointWith rdf:resource="#Lecturer"/>
</owl:Class>

<owl:Class rdf:about="#Lecturer">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Lecture">
  <rdfs:subClassOf rdf:resource="#Activity"/>
</owl:Class>

<owl:Class rdf:about="#Exam">
  <rdfs:subClassOf rdf:resource="#Activity"/>
</owl:Class>

<owl:Class rdf:about="#GroupWork">
  <rdfs:subClassOf rdf:resource="#Activity"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#e2">
  <rdf:type rdf:resource="#Classroom"/>
  <equippedWith rdf:resource="#whiteboard_e2"/>
  <equippedWith rdf:resource="#projector_e2"/>
  <equippedWith rdf:resource="#pir_e2"/>
  <usedFor rdf:resource="#ami_lecture"/>
  <equippedWith rdf:resource="#desk_1"/>
  <equippedWith rdf:resource="#desk_2"/>
  <equippedWith rdf:resource="#desk_3"/>
  <equippedWith rdf:resource="#desk_4"/>
  <hasHeadCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</hasHeadCount>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#e1">
  <rdf:type rdf:resource="#Classroom"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#corridor_first_floor">
  <rdf:type rdf:resource="#Corridor"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#whiteboard_e2">
  <rdf:type rdf:resource="#Whiteboard"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#projector_e2">
  <rdf:type rdf:resource="#Projector"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#pir_e2">
  <rdf:type rdf:resource="#PresenceSensor"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ami_lecture">
  <rdf:type rdf:resource="#Lecture"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#desk_1">
  <rdf:type rdf:resource="#Desk"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#alice">
  <rdf:type rdf:resource="#Student"/>
  <seatedAt rdf:resource="#desk_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#desk_2">
  <rdf:type rdf:resource="#Desk"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#bruno">
  <rdf:type rdf:resource="#Student"/>
  <seatedAt rdf:resource="#desk_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#desk_3">
  <rdf:type rdf:resource="#Desk"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#chiara">
  <rdf:type rdf:resource="#Student"/>
  <seatedAt rdf:resource="#desk_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#desk_4">
  <rdf:type rdf:resource="#Desk"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#dario">
  <rdf:type rdf:resource="#Student"/>
  <seatedAt rdf:resource="#desk_4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lucrezia">
  <rdf:type rdf:resource="#Lecturer"/>
  <isIn rdf:resource="#e2"/>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Room"/>
    <rdf:Description rdf:about="#Furniture"/>
    <rdf:Description rdf:about="#Device"/>
    <rdf:Description rdf:about="#Person"/>
    <rdf:Description rdf:about="#Activity"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
